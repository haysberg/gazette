# Gazette — Caddy site config for a bare-metal / VPS deployment.
#
# The gazette service pre-renders every page; Caddy only ever reads files. Because
# each page is written together with .br and .gz siblings, `precompressed` lets
# Caddy hand those bytes straight to the client and never compress a response
# itself — the homepage and the RSS feed included. There is deliberately no
# `encode` directive: adding one would compress on the fly per request, which is
# exactly the cost this setup removes.
#
# Replace the site address with your own domain. Caddy provisions TLS automatically.

insoumis.news {
	root * /opt/gazette/static

	# Security headers on every response (mirrors sws.toml). The CSP is sent as a
	# real header (not a <meta>) so frame-ancestors and the other directives apply.
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'inline-speculation-rules'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://insoumis.goatcounter.com; manifest-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "interest-cohort=(), browsing-topics=()"
		-Server
	}

	# Advertise the feed alternates on HTML responses. "/" is listed explicitly
	# because the path matcher sees the request path, not the resolved index file.
	@html path / *.html
	header @html Link `</feed.xml>; rel="alternate"; type="application/rss+xml"; title="Gazette Insoumise — RSS", </feeds.opml>; rel="alternate"; type="text/x-opml"; title="Gazette Insoumise — OPML"`

	# Deploy-time assets, all query-string fingerprinted by the templates, so they
	# can be cached for a year. /js/*.js does not match /sw.js, handled below.
	@immutable path *.css *.woff2 *.avif *.png *.ico *.json /js/*.js
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Pages, the feed and status.json are regenerated every 15 minutes; the service
	# worker needs a short TTL so updates actually reach installed clients. This
	# comes after @immutable so /status.json overrides the *.json rule.
	@shortlived path / *.html *.xml /sw.js /source/* /status.json
	header @shortlived Cache-Control "public, max-age=900"

	# Serves 404.html with a real 404 status rather than 200.
	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}

	file_server {
		precompressed br gzip
	}
}
